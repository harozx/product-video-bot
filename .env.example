# ╔══════════════════════════════════════════╗
# ║     Auto Content Pipeline — Config       ║
# ╚══════════════════════════════════════════╝

# === Google AI ===
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=./credentials/key.json
GCS_BUCKET=auto-content-media
GEMINI_MODEL=gemini-2.5-flash

# Veo config
VEO_MODEL=veo-3.1-generate-001
VEO_DEFAULT_TIER=lite
VEO_DURATION=6s
VEO_ASPECT_RATIO=9:16

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_bot_token
# Required: only these Telegram user IDs may use the bot (empty = nobody).
# Unknown users' IDs are logged, so message the bot once and copy yours from the log.
TELEGRAM_ADMIN_IDS=123456789,987654321

# === Cloudflare R2 ===
CF_ACCOUNT_ID=your_cf_account_id
CF_R2_ACCESS_KEY=your_r2_access_key
CF_R2_SECRET_KEY=your_r2_secret_key
CF_R2_BUCKET=auto-content
CF_R2_PUBLIC_URL=https://your-r2-domain.com

# === Facebook ===
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret

# === Proxy ===
PROXY_PROVIDER=iproyal

# === System ===
DATABASE_PATH=./data/database.db
TEMP_DIR=./data/temp
MUSIC_DIR=./music
PROFILES_DIR=./data/profiles

LOCAL_RETENTION_DAYS=7
R2_RETENTION_DAYS=90
CLEANUP_HOUR=3

# === MoneyPrinterTurbo (free AI Review / Stock Video tiers) ===
TURBO_BASE_URL=http://127.0.0.1:8080

# === Server ===
# The API has no authentication: keep 127.0.0.1 unless it sits behind an
# authenticating reverse proxy.
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false
